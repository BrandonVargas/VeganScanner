// Copy to Secrets.xcconfig (git-ignored) to enable online features such as ingredient web research.
// xcconfig treats "//" as a comment, so only the host goes here; the app adds "https://".
// The publishable key is safe to ship in apps: database access is enforced by Row Level Security.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxx
