<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the build-setting generated Info.plist (GENERATE_INFOPLIST_FILE). -->
	<!-- Online features (Supabase), from Configuration/Secrets.xcconfig. Blank values turn them off. -->
	<key>SupabaseHost</key>
	<string>$(SUPABASE_HOST)</string>
	<key>SupabasePublishableKey</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.brandonvargas.veganscanner</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>veganscanner</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
