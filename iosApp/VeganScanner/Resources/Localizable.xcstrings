{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "action.open_in_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Open Food Facts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir en Open Food Facts"
          }
        }
      }
    },
    "action.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        }
      }
    },
    "action.scan_another": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan another product"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear otro producto"
          }
        }
      }
    },
    "camera.open_settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Configuración"
          }
        }
      }
    },
    "camera.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera isn't available. Allow camera access in Settings, or type the barcode below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está disponible. Permite el acceso en Configuración o escribe el código abajo."
          }
        }
      }
    },
    "error.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your internet connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu conexión a internet e inténtalo de nuevo."
          }
        }
      }
    },
    "error.rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many lookups in a short time. Wait a minute and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas búsquedas en poco tiempo. Espera un minuto e inténtalo de nuevo."
          }
        }
      }
    },
    "error.service_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts is busy right now. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts está ocupado. Inténtalo en un momento."
          }
        }
      }
    },
    "error.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal"
          }
        }
      }
    },
    "error.unexpected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unexpected error happened. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocurrió un error inesperado. Inténtalo de nuevo."
          }
        }
      }
    },
    "history.clear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear history"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar historial"
          }
        }
      }
    },
    "history.clear_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes every product from your history on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todos los productos de tu historial en este dispositivo."
          }
        }
      }
    },
    "history.clear_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear scan history?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar el historial?"
          }
        }
      }
    },
    "history.empty_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Products you scan will appear here, even offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los productos que escanees aparecerán aquí, incluso sin conexión."
          }
        }
      }
    },
    "history.empty_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No scans yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay escaneos"
          }
        }
      }
    },
    "ingredient_status.maybe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "may come from animals"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "puede ser de origen animal"
          }
        }
      }
    },
    "ingredient_status.no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not vegan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no vegano"
          }
        }
      }
    },
    "ingredient_status.unknown": {
      "extractionState": "manual",
      "localizations": {
