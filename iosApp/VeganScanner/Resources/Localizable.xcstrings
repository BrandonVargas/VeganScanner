          "stringUnit": {
            "state": "translated",
            "value": "not recognized"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no reconocido"
          }
        }
      }
    },
    "manual_entry.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a valid barcode"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese no parece un código de barras válido"
          }
        }
      }
    },
    "manual_entry.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. 7501234567893"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ej. 7501234567893"
          }
        }
      }
    },
    "manual_entry.submit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar"
          }
        }
      }
    },
    "manual_entry.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or type the barcode"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O escribe el código de barras"
          }
        }
      }
    },
    "not_found.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcode %@ isn't in Open Food Facts yet. You can add it so everyone benefits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código %@ aún no está en Open Food Facts. Puedes agregarlo para que todos se beneficien."
          }
        }
      }
    },
    "not_found.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Product not found"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Producto no encontrado"
          }
        }
      }
    },
    "product.unnamed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unnamed product"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Producto sin nombre"
          }
        }
      }
    },
    "result.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data from Open Food Facts contributors (ODbL). Verdicts are a guide only. Ingredients change, so always check the label."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de los colaboradores de Open Food Facts (ODbL). Los resultados son solo una guía. Los ingredientes cambian, así que revisa siempre la etiqueta."
          }
        }
      }
    },
    "result.flagged_check": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingredients to double-check"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingredientes a revisar"
          }
        }
      }
    },
    "result.flagged_non_vegan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-vegan ingredients"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingredientes no veganos"
          }
        }
      }
    },
    "result.inconclusive_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm this one. Check the label yourself or contact the manufacturer. Scanning the ingredient label with on-device AI is coming soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos confirmarlo. Revisa la etiqueta o contacta al fabricante. Pronto podrás escanear la etiqueta de ingredientes con IA en el dispositivo."
          }
        }
      }
    },
    "result.ingredients": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingredients"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingredientes"
          }
        }
      }
    },
    "result.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultado"
          }
        }
      }
    },
